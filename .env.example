# Copy to .env and fill in real values. Never commit the real .env file.

# --- Application ---
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
JWT_SECRET=replace_me_with_a_long_random_value

# --- Database (docker-compose overrides host to `postgres`; host port is remapped to 6333 in docker-compose.yml to avoid clashing with a local Postgres on 5432) ---
POSTGRES_DB=aivideo
POSTGRES_USER=app
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql+asyncpg://app:password@localhost:6333/aivideo

# --- Redis (docker-compose overrides host to `redis`; host port is remapped to 6000 in docker-compose.yml to avoid clashing with a local Redis on 6379) ---
REDIS_URL=redis://localhost:6000/0

# --- Object storage (MinIO by default via docker-compose) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=aivideo-assets
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# --- AI providers ---
# Leave as "mock" to run the full pipeline with zero external API keys
# (useful for local dev, demos, and CI). Point at a real provider name
# and supply its key to use production-quality generation.
LLM_PROVIDER=mock
LLM_API_KEY=

VOICE_PROVIDER=mock
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

IMAGE_PROVIDER=mock
IMAGE_API_KEY=

VIDEO_PROVIDER=mock
VIDEO_API_KEY=

# --- Publishing ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# --- Billing ---
BILLING_PROVIDER=
BILLING_SECRET_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
