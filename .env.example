# Copy to .env and fill in real values. Never commit the real .env file.

# --- Application ---
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
JWT_SECRET=replace_me_with_a_long_random_value

# --- Database (docker-compose overrides host to `postgres`; host port is remapped to 6333 in docker-compose.yml to avoid clashing with a local Postgres on 5432) ---
POSTGRES_DB=aivideo
POSTGRES_USER=app
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql+asyncpg://app:password@localhost:6333/aivideo

# --- Redis (docker-compose overrides host to `redis`; host port is remapped to 6000 in docker-compose.yml to avoid clashing with a local Redis on 6379) ---
REDIS_URL=redis://localhost:6000/0

# --- Object storage (MinIO by default via docker-compose) ---
STORAGE_ENDPOINT=http://localhost:9000
# Browser-reachable endpoint for signed download/thumbnail URLs (not the Docker hostname).
STORAGE_PUBLIC_BASE_URL=http://localhost:9000
STORAGE_BUCKET=aivideo-assets
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# --- AI providers ---
# Leave as "mock" to run the full pipeline with zero external API keys
# (useful for local dev, demos, and CI). Point at a real provider name
# and supply its key to use production-quality generation.
LLM_PROVIDER=mock
LLM_API_KEY=

# Set VOICE_PROVIDER=openai and/or IMAGE_PROVIDER=openai to enable live
# media generation. OpenAI API usage is billable; no key is required for mock.
# Keep this key secret and configure it on BOTH API and worker services.
OPENAI_API_KEY=
VOICE_PROVIDER=mock
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_DEFAULT_VOICE=alloy
IMAGE_PROVIDER=mock
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium
# Reserved for future providers; not implemented in this phase:
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
IMAGE_API_KEY=

VIDEO_PROVIDER=mock
VIDEO_API_KEY=

# --- Publishing ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# --- Billing ---
BILLING_PROVIDER=
BILLING_SECRET_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- AI credit accounting and global live-provider circuit breaker ---
# Set true for billable deployment (required if real media providers are on in production).
# CRD is an internal usage unit, not USD or provider costs; refunds apply to failed jobs.
CREDIT_ENFORCEMENT_ENABLED=false
SIGNUP_STARTER_CREDITS=0
CREDITS_PER_30_SECONDS=10
SCENE_REGENERATION_CREDITS=2
VOICE_PREVIEW_CREDITS=1
MAX_DAILY_LIVE_MEDIA_CALLS=100

# Admin accounts: copy a verified /users/me UUID for a trusted account.
# Keep this on the backend only. Do not put this in NEXT_PUBLIC_* variables.
# Sign-up email addresses do not confer privileges.
ADMIN_USER_IDS_RAW=

# --- Administrator second-factor security ---
# Required when ADMIN_USER_IDS_RAW is nonempty in production. Must remain
# consistent across deployments; store as a server-side secret, never in git.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADMIN_MFA_ENCRYPTION_KEY=

# Phase 8 — transactional password recovery email via Resend.
# Configure BOTH variables on the backend to enable forgot-password flow.
# APP_URL must be your actual HTTPS frontend origin in production.
RESET_EMAIL_API_KEY=
RESET_EMAIL_FROM=
